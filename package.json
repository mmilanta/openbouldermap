{
  "name": "openbouldermap",
  "version": "0.2.0",
  "private": true,
  "description": "Worldwide bouldering map — basemap from OpenFreeMap, climbing data from self-hosted PMTiles.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/search-browser.mjs && node tests/editor-browser.mjs",
    "build": "vite build && mkdir -p dist/tiles && cp tiles/climbing.pmtiles tiles/climbing-metadata.json tiles/climbing-search.json dist/tiles/",
    "preview": "vite preview --port 4173",
    "build-tiles": "bash scripts/build-climbing-tiles.sh",
    "serve-tiles": "npx tsx scripts/serve-tiles.ts 8081"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "playwright": "^1.61.1",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "maplibre-gl": "^6.9.0",
    "pmtiles": "^3.0.7"
  }
}
